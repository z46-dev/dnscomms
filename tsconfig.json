{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": ["vite/client", "bun"]
    },
    "include": [
        "web/app",
        "web/vite-wasm.ts",
        "web/wasm.test.ts",
        "vite.config.ts",
        "web/browser.check.ts",
        "playwright.config.ts"
    ]
}
